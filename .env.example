# Copier en .env (jamais commité) pour changer ces valeurs sur votre poste.
# Sans .env, les valeurs par défaut de compose.yaml s'appliquent : rien à faire pour démarrer.
# Docker Compose et Spring Boot lisent .env tout seuls.

# Base PostgreSQL de développement (conteneur Docker)
DB_NAME=quizzard
DB_USER=quizzard
DB_PASSWORD=quizzard
# Port côté machine : 5433, car le 5432 est souvent pris par un PostgreSQL installé sur le poste.
DB_PORT=5433

# Front React autorisé par CORS (lu par Spring Boot)
FRONT_URL=http://localhost:5173

# Développement uniquement, tant que la connexion n'existe pas : true ouvre toutes les routes
# (Postman, front React). Ne jamais mettre true sur le serveur.
SECURITE_OUVERTE=false
